#!/bin/sh
#
# @name ResQMesh Relay (Gazebo)
#
# @type Quadrotor
#
# Generated by sim/tools/gen_airframes.py. Masses behind these numbers are placeholders.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=resqmesh_landslide}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=resqmesh_relay}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.0688
param set-default CA_ROTOR0_PY 0.0688
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_PX -0.0688
param set-default CA_ROTOR1_PY -0.0688
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX 0.0688
param set-default CA_ROTOR2_PY -0.0688
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -0.0688
param set-default CA_ROTOR3_PY 0.0688
param set-default CA_ROTOR3_KM -0.05
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN4 150
param set-default SIM_GZ_EC_MAX4 1000

# hover thrust from mass 0.617 kg (placeholder); the PX4 hover-thrust estimator refines it in flight
param set-default MPC_THR_HOVER 0.32

# rate gains: PX4 defaults scaled by control authority vs x500 (roll/pitch /3.8, yaw /19.3)
param set-default MC_ROLLRATE_P 0.0392
param set-default MC_ROLLRATE_I 0.0523
param set-default MC_ROLLRATE_D 0.0008
param set-default MC_PITCHRATE_P 0.0392
param set-default MC_PITCHRATE_I 0.0523
param set-default MC_PITCHRATE_D 0.0008
param set-default MC_YAWRATE_P 0.0104
param set-default MC_YAWRATE_I 0.0052

# mission behaviour: offboard, generous limits for a 5-inch frame
param set-default MPC_XY_VEL_MAX 12
param set-default MPC_Z_VEL_MAX_UP 4
param set-default MPC_TILTMAX_AIR 35
# yaw: a low-inertia frame saturates its mixer on a big heading step, so turn gently
param set-default MC_YAW_P 2.0
param set-default MC_YAWRATE_MAX 60
param set-default MPC_YAWRAUTO_MAX 45
param set-default COM_OF_LOSS_T 2
param set-default COM_OBL_RC_ACT 4
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
param set-default COM_RCL_EXCEPT 4
param set-default COM_ARM_WO_GPS 0
param set-default SIM_BAT_DRAIN 7200
param set-default SIM_BAT_MIN_PCT 70
param set-default COM_LOW_BAT_ACT 0
param set-default EKF2_BCOEF_X 0.0
param set-default EKF2_BCOEF_Y 0.0
param set-default EKF2_MCOEF 0.12
